[Unit]
Description=Create an encrypted Hoodmin backup
After=postgresql.service
[Service]
Type=oneshot
ExecStart=/usr/sbin/hoodmin-backup-export
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/hoodmin
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=30min
