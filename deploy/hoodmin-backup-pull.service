[Unit]
Description=Fetch encrypted Hoodmin backup using read-only SSH
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/hoodmin-cli backup pull --host panel.example.com --user root --identity /root/.ssh/hoodmin-backup-pull --known-hosts /root/.ssh/hoodmin-backup-known-hosts
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/hoodmin-remote /var/lib/hoodmin
TimeoutStartSec=10min
