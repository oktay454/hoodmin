#!/bin/bash
set -euo pipefail
umask 077
YEDEK_KOKU="/var/backups/hoodmin"
ZAMAN="$(date -u +%Y%m%dT%H%M%SZ)"
if [ "$(id -u)" -ne 0 ]
then
	printf '%s\n' 'Root gereklidir.' >&2
	exit 1
fi
install -d -m0700 "${YEDEK_KOKU}"
YEDEK_DIZINI="$(mktemp -d "${YEDEK_KOKU}/${ZAMAN}.XXXXXX")"
runuser -u postgres -- pg_dump --format=custom vpnhood_manager >"${YEDEK_DIZINI}/database.dump.partial"
mv "${YEDEK_DIZINI}/database.dump.partial" "${YEDEK_DIZINI}/database.dump"
install -m0600 /var/lib/hoodmin/master.key "${YEDEK_DIZINI}/master.key"
install -m0600 /etc/hoodmin/hoodmin.env "${YEDEK_DIZINI}/hoodmin.env"
cp -a /etc/hoodmin "${YEDEK_DIZINI}/configuration"
if [ -d /etc/letsencrypt ]
then
	cp -a /etc/letsencrypt "${YEDEK_DIZINI}/letsencrypt"
fi
dpkg-query -W hoodmin >"${YEDEK_DIZINI}/package-version.txt"
(
	cd "${YEDEK_DIZINI}"
	sha256sum database.dump master.key hoodmin.env package-version.txt >SHA256SUMS
)
printf '%s\n' "${YEDEK_DIZINI}"
