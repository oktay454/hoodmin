#!/usr/bin/python3
"""Certbot hooks: authenticated Hoodmin HTTP01 relay and PFX deployment."""
import base64
import json
import os
from pathlib import Path
import socket
import ssl
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import urllib.parse
import uuid

class NoRedirect(urllib.request.HTTPRedirectHandler):
	def redirect_request(self,*args):return None

if os.geteuid()!=0 or len(sys.argv)!=3 or sys.argv[1] not in ('auth','cleanup','deploy'):
	raise SystemExit('Usage: hoodmin-acme {auth|cleanup|deploy} ROOT_ONLY_CONFIG.json')
mode=sys.argv[1];path=Path(sys.argv[2]);metadata=path.stat()
if metadata.st_uid!=0 or stat.S_IMODE(metadata.st_mode)&0o077:
	raise SystemExit('ACME configuration must be root-owned and private (0600).')
config=json.loads(path.read_text());origin=config['origin'];domain=config['domain'];server=str(uuid.UUID(config['server']))
url=urllib.parse.urlsplit(origin)
if url.scheme!='https' or not url.hostname or url.username or url.password or url.path or url.query or url.fragment:
	raise SystemExit('A plain HTTPS API origin is required.')
if not domain or any(c not in 'abcdefghijklmnopqrstuvwxyz0123456789-.' for c in domain):
	raise SystemExit('Invalid certificate domain.')
if mode in ('auth','cleanup') and os.environ.get('CERTBOT_DOMAIN')!=domain:
	raise SystemExit('Certbot domain does not match the configured VPN server.')
client=urllib.request.build_opener(urllib.request.HTTPSHandler(context=ssl.create_default_context()),NoRedirect())
def api(suffix,data=None):
	request=urllib.request.Request(f'{origin}/api/manage/servers/{server}/{suffix}',data=None if data is None else json.dumps(data).encode(),headers={'Authorization':config['authorization'],'Content-Type':'application/json'})
	try:
		with client.open(request,timeout=20) as response:return json.load(response)
	except urllib.error.HTTPError as error:
		raise SystemExit(f'Hoodmin API refused {suffix}: HTTP {error.code}') from None

def applied():
	for attempt in range(60):
		current=api('configuration');status=current.get('status') or {}
		if status.get('configCode')==current['base_code']:
			if status.get('configError'):raise SystemExit('VPN server reported a configuration error.')
			return
		time.sleep(2)
	raise SystemExit('VPN server did not acknowledge the updated configuration.')

if mode=='auth':
	token=os.environ['CERTBOT_TOKEN'];proof=os.environ['CERTBOT_VALIDATION']
	api('challenge',dict(token=token,key_authorization=proof,confirmed=True));applied()
	for attempt in range(15):
		try:
			with client.open(f'http://{domain}/.well-known/acme-challenge/{token}',timeout=10) as response:
				if response.read(2048).decode()==proof:break
		except (OSError,urllib.error.HTTPError):pass
		time.sleep(2)
	else:raise SystemExit('VPN public TCP80 challenge response could not be verified.')
	print('Hoodmin HTTP01 response acknowledged and publicly verified.')
elif mode=='cleanup':
	current=api('configuration');settings=current['settings'];settings['enableHttp01Challenge']=False
	api('configuration',dict(base_code=current['base_code'],settings=settings,confirmed=True));applied()
	print('Hoodmin HTTP01 listener disabled after validation.')
else:
	lineage=Path(os.environ['RENEWED_LINEAGE'])
	if lineage!=Path('/etc/letsencrypt/live')/config.get('cert_name',domain):
		raise SystemExit('Unexpected certificate lineage.')
	with tempfile.TemporaryDirectory(prefix='hoodmin-acme-') as directory:
		pfx=Path(directory)/'certificate.pfx'
		subprocess.run(['openssl','pkcs12','-export','-inkey',str(lineage/'privkey.pem'),'-in',str(lineage/'cert.pem'),'-certfile',str(lineage/'chain.pem'),'-out',str(pfx),'-passout','pass:'],check=True,capture_output=True)
		pfx.chmod(0o600)
		current=api('configuration')
		api('certificates',dict(base_code=current['base_code'],pfx=base64.b64encode(pfx.read_bytes()).decode(),password='',tls_name=domain,make_default=True,confirmed=True));applied()
	expected=subprocess.run(['openssl','x509','-in',str(lineage/'cert.pem'),'-outform','DER'],check=True,capture_output=True).stdout
	with socket.create_connection((domain,443),timeout=15) as connection:
		with ssl.create_default_context().wrap_socket(connection,server_hostname=domain) as tls:
			if tls.getpeercert(binary_form=True)!=expected:raise SystemExit('The public VPN TLS certificate differs from the renewed certificate.')
	print('Renewed PFX applied through Hoodmin and public CA-validated TLS verified.')
