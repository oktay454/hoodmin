#!/bin/bash
set -euo pipefail
umask 077
if [ "$(id -u)" -ne 0 ]
then
	printf '%s\n' 'Root gereklidir.' >&2
	exit 1
fi
ALICI="$(cat /etc/hoodmin/backup-recipient.txt)"
YEDEK_DIZINI="$(/usr/sbin/hoodmin-backup)"
GECICI_DOSYA="$(mktemp /var/backups/hoodmin/export.XXXXXX)"
trap 'rm -f "${GECICI_DOSYA}"' EXIT
tar -C "${YEDEK_DIZINI}" -cf - . | age --encrypt --recipient "${ALICI}" --output "${GECICI_DOSYA}"
mv -f "${GECICI_DOSYA}" /var/backups/hoodmin/latest.age
printf '%s\n' 'Şifreli Hoodmin yedeği hazırlandı.'
