[Unit]
Description=Hoodmin bağımsız VpnHood yönetim paneli
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=hoodmin
Group=hoodmin
Environment="DATABASE_URL=postgresql:///vpnhood_manager?host=/var/run/postgresql&user=hoodmin"
Environment="VHM_PUBLIC_ORIGIN=https://yapayzeka:3443"
Environment="VHM_MASTER_KEY_FILE=/var/lib/vpnhood-manager/master.key"
ExecStart=/usr/lib/vpnhood-manager/vpnhood-manager serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RuntimeDirectory=vpnhood-manager
RuntimeDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
