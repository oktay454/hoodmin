#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_test:
	cargo test --workspace --locked

override_dh_auto_install:
	install -d debian/hoodmin/usr/share/doc/hoodmin/docs
	install -m0644 docs/*.md debian/hoodmin/usr/share/doc/hoodmin/docs/
	cargo metadata --locked --format-version 1 | python3 scripts/dependency-licenses.py >debian/hoodmin/usr/share/doc/hoodmin/dependency-licenses.json
	install -Dm0755 target/release/hoodmin debian/hoodmin/usr/bin/hoodmin
	install -Dm0755 target/release/hoodmin-cli debian/hoodmin/usr/bin/hoodmin-cli
	install -Dm0644 deploy/hoodmin.json debian/hoodmin/etc/hoodmin/hoodmin.json
	install -d debian/hoodmin/usr/share/hoodmin/migrations
	install -m0644 migrations/*.sql debian/hoodmin/usr/share/hoodmin/migrations/

override_dh_installsystemd:
	dh_installsystemd --no-start --no-enable

override_dh_auto_clean:

# Preserve Markdown filenames so links work in the installed handbook.
override_dh_compress:
	dh_compress -X.md
