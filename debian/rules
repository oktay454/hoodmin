#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_test:
	cargo test --workspace --locked

override_dh_auto_install:
	install -d debian/hoodmin/usr/share/doc/hoodmin
	cargo metadata --locked --format-version 1 | python3 scripts/dependency-licenses.py >debian/hoodmin/usr/share/doc/hoodmin/dependency-licenses.json
	install -Dm0755 target/release/vpnhood-manager debian/hoodmin/usr/bin/hoodmin
	install -Dm0755 scripts/hoodmin-db-setup debian/hoodmin/usr/sbin/hoodmin-db-setup
	install -Dm0755 scripts/hoodmin-create-owner debian/hoodmin/usr/sbin/hoodmin-create-owner
	install -Dm0755 scripts/hoodmin-acme debian/hoodmin/usr/sbin/hoodmin-acme
	install -Dm0755 scripts/hoodmin-backup-export debian/hoodmin/usr/sbin/hoodmin-backup-export
	install -Dm0755 scripts/hoodmin-backup debian/hoodmin/usr/sbin/hoodmin-backup
	install -Dm0644 deploy/hoodmin.env debian/hoodmin/etc/hoodmin/hoodmin.env
	install -d debian/hoodmin/usr/share/hoodmin/migrations
	install -m0644 migrations/*.sql debian/hoodmin/usr/share/hoodmin/migrations/

override_dh_installsystemd:
	dh_installsystemd --no-start --no-enable

override_dh_auto_clean:
